# Required: Your Groq API key (starts with gsk_...)
GROQ_API_KEY=your_key_here

# Optional: LLM model to use (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Groq SDK automatic retries for temporary failures (default: 1, range: 0-3)
GROQ_MAX_RETRIES=1

# Optional: Directory where course JSON files are saved (default: saved_courses)
MINICLASSBUILD_SAVE_DIR=saved_courses
